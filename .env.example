# Copy to `.env` and restart `npm run dev`.
# Never commit real keys. For production, proxy APIs through your backend.

VITE_OPENAI_API_KEY=
# Optional: default is https://api.openai.com/v1 (OpenAI-compatible endpoints work)
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
# VITE_OPENAI_MODEL=gpt-4o-mini

# Optional backend (recommended): if set, the frontend will send data + use server-side AI routes.
# VITE_BACKEND_URL=http://localhost:8787
